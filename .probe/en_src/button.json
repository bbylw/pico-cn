{
 "meta": {
  "slug": "button",
  "chapter": "Content",
  "title": "Button",
  "lead": "Buttons are using the native `<button>` tag, without  `.classes`. for the default style.",
  "url": "https://picocss.com/docs/button"
 },
 "blocks": [
  {
   "t": "example",
   "label": "Button example",
   "demo": "<article aria-label=\"Button example\" class=\"component\"><button>Button</button></article>",
   "lang": "html",
   "code": "<button>Button</button>"
  },
  {
   "t": "h2",
   "text": "Variants",
   "id": "variants"
  },
  {
   "t": "p",
   "md": "Buttons come with `.secondary` and `.contrast` styles (not available in the [class-less version](https://picocss.com/docs/classless))."
  },
  {
   "t": "example",
   "label": "Button colors example",
   "demo": "<article aria-label=\"Button colors example\" class=\"component\"><div class=\"grid\"><button class=\"secondary\">Secondary</button><button class=\"contrast\">Contrast</button></div></article>",
   "lang": "html",
   "code": "<button class=\"secondary\">Secondary</button>\n<button class=\"contrast\">Contrast</button>"
  },
  {
   "t": "p",
   "md": "They also come with a classic outline style (not available in the [class-less version](https://picocss.com/docs/classless))."
  },
  {
   "t": "example",
   "label": "Buttons outline example",
   "demo": "<article aria-label=\"Buttons outline example\" class=\"component\"><div class=\"grid\"><button class=\"outline\">Primary</button><button class=\"outline secondary\">Secondary</button><button class=\"outline contrast\">Contrast</button></div></article>",
   "lang": "html",
   "code": "<button class=\"outline\">Primary</button>\n<button class=\"outline secondary\">Secondary</button>\n<button class=\"outline contrast\">Contrast</button>"
  },
  {
   "t": "h2",
   "text": "Form buttons",
   "id": "form-buttons"
  },
  {
   "t": "p",
   "md": "`type=\"submit\"` and `type=\"button\"` inputs are also displayed as buttons. All form buttons are `width: 100%;` by default, to match with the other form elements."
  },
  {
   "t": "example",
   "label": "Input buttons example",
   "demo": "<article aria-label=\"Input buttons example\" class=\"component\"><input type=\"submit\"/><input type=\"button\" value=\"Input\"/></article>",
   "lang": "html",
   "code": "<input type=\"submit\">\n<input type=\"button\" value=\"Input\">"
  },
  {
   "t": "p",
   "md": "Reset inputs have the secondary style by default."
  },
  {
   "t": "example",
   "label": "Reset input example",
   "demo": "<article aria-label=\"Reset input example\" class=\"component\"><input type=\"reset\"/></article>",
   "lang": "html",
   "code": "<input type=\"reset\">"
  },
  {
   "t": "h2",
   "text": "Disabled",
   "id": "disabled"
  },
  {
   "t": "p",
   "md": "Buttons come with a disabled style."
  },
  {
   "t": "example",
   "label": "Disabled buttons example",
   "demo": "<article aria-label=\"Disabled buttons example\" class=\"component\"><div class=\"grid\"><button disabled=\"\">Disabled</button><button class=\"secondary\" disabled=\"\">Disabled</button><button class=\"contrast\" disabled=\"\">Disabled</button></div></article>",
   "lang": "html",
   "code": "<button disabled>Disabled</button>\n<button class=\"secondary\" disabled>Disabled</button>\n<button class=\"contrast\" disabled>Disabled</button>"
  },
  {
   "t": "h2",
   "text": "Role button",
   "id": "role-button"
  },
  {
   "t": "p",
   "md": "Clickable elements with `role=\"button\"` are rendered as buttons."
  },
  {
   "t": "example",
   "label": "Role button example",
   "demo": "<article aria-label=\"Role button example\" class=\"component\"><div role=\"button\" tabindex=\"0\">Div as button</div></article>",
   "lang": "html",
   "code": "<div role=\"button\" tabindex=\"0\">Div as a button</div>"
  },
  {
   "t": "h2",
   "text": "Usage with group",
   "id": "usage-with-group"
  },
  {
   "t": "p",
   "md": "You can use `role=\"group\"` with buttons. See [Group](https://picocss.com/docs/group)."
  },
  {
   "t": "example",
   "label": "Group example",
   "demo": "<article aria-label=\"Group example\" class=\"component\"><div role=\"group\"><button>Button</button><button>Button</button><button>Button</button></div></article>",
   "lang": "html",
   "code": "<div role=\"group\">\n  <button>Button</button>\n  <button>Button</button>\n  <button>Button</button>\n</div>"
  }
 ]
}