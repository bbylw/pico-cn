---
import { Search, Github, Sun, Moon, Menu } from "lucide-astro";
const PICO_VERSION = "2.1.1";
const base = import.meta.env.BASE_URL;
---

<header class="site-header">
  <div class="site-header-nav">
    <div class="header-left">
      <a href={base} class="header-brand" aria-label="Pico CSS 首页">
        <img src={`${base}img/logo-light.svg`} alt="Pico CSS" class="header-logo logo-light" height="25" />
        <img src={`${base}img/logo-dark.svg`} alt="Pico CSS" class="header-logo logo-dark" height="25" />
        <span class="header-version-pill">v{PICO_VERSION}</span>
      </a>
    </div>

    <div class="header-center">
      <button type="button" class="header-search-trigger" data-open-search aria-label="搜索文档 (快捷键 ⌘K)">
        <Search size={15} />
        <span class="search-placeholder">搜索文档与组件...</span>
        <kbd>⌘K</kbd>
      </button>
    </div>

    <div class="header-actions">
      <a href={`${base}docs/`} class="header-nav-link">文档</a>
      <a
        href="https://github.com/picocss/pico"
        class="header-nav-link"
        rel="noopener external"
        target="_blank"
        aria-label="Pico CSS GitHub 仓库"
      >
        <Github size={17} />
        <span>GitHub</span>
      </a>

      <button
        type="button"
        class="header-icon-btn"
        aria-label="切换明暗模式"
        data-theme-toggle
        title="切换主题 (浅色/深色)"
      >
        <Sun class="theme-icon sun-icon" size={18} />
        <Moon class="theme-icon moon-icon" size={18} />
      </button>

      <button
        type="button"
        class="header-icon-btn mobile-menu-btn"
        id="mobile-drawer-toggle"
        aria-label="打开侧边菜单"
      >
        <Menu size={19} />
      </button>
    </div>
  </div>
</header>

<style>
  .header-left {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .logo-light {
    display: inline-block;
  }
  .logo-dark {
    display: none;
  }
  html[data-theme="dark"] .logo-light {
    display: none;
  }
  html[data-theme="dark"] .logo-dark {
    display: inline-block;
  }

  .sun-icon {
    display: block;
  }
  .moon-icon {
    display: none;
  }
  html[data-theme="dark"] .sun-icon {
    display: none;
  }
  html[data-theme="dark"] .moon-icon {
    display: block;
  }

  @media (max-width: 640px) {
    .header-nav-link {
      display: none !important;
    }
  }
</style>
