---
const PICO_VERSION = "2.1.1";
---

<header class="site-header">
  <nav>
    <ul>
      <li>
        <a href="/" aria-label="Home">
          <img src="/img/logo-light.svg" alt="Pico CSS" class="logo logo-light" height="24" />
          <img src="/img/logo-dark.svg" alt="Pico CSS" class="logo logo-dark" height="24" />
          <span class="vmark">v{PICO_VERSION}</span>
        </a>
      </li>
    </ul>
    <ul>
      <li><a href="/docs/" class="secondary">文档</a></li>
      <li>
        <a href="https://github.com/picocss/pico" class="secondary" rel="noopener external" target="_blank" aria-label="GitHub 仓库">GitHub</a>
      </li>
      <li>
        <button
          class="theme-toggle contrast"
          aria-label="切换明暗模式"
          data-theme-toggle
          style="padding: 0.35rem 0.6rem; line-height: 1;"
        >
          <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="12" cy="12" r="5" /><path d="M12 1v2m0 18v2M4.2 4.2l1.4 1.4m12.8 12.8 1.4 1.4M1 12h2m18 0h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4" />
          </svg>
          <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
          </svg>
        </button>
      </li>
    </ul>
  </nav>
</header>

<style>
  .logo-light { display: inline; }
  .logo-dark { display: none; }
  html[data-theme="dark"] .logo-light { display: none; }
  html[data-theme="dark"] .logo-dark { display: inline; }
  .vmark {
    font-size: 0.72rem;
    color: var(--pico-color-grey-600);
    border: 1px solid var(--pico-muted-border-color);
    border-radius: 999px;
    padding: 0.05rem 0.5rem;
    vertical-align: 6px;
  }
  html[data-theme="dark"] .vmark { color: var(--pico-color-grey-400); }
</style>
