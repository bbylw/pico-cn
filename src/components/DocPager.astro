---
import { DOCS_FLAT } from "../data/docs-nav";
import { ArrowLeft, ArrowRight } from "lucide-astro";

interface Props {
  id: string;
}
const { id } = Astro.props;
const idx = DOCS_FLAT.findIndex((i) => i.id === id);
const prev = idx > 0 ? DOCS_FLAT[idx - 1] : undefined;
const next = idx >= 0 && idx < DOCS_FLAT.length - 1 ? DOCS_FLAT[idx + 1] : undefined;
const href = (i: string) => (i === "quickstart" ? `${import.meta.env.BASE_URL}docs/` : `${import.meta.env.BASE_URL}docs/${i}/`);
---

{
  (prev || next) && (
    <nav class="doc-pager-grid" aria-label="上一篇与下一篇">
      {prev ? (
        <a href={href(prev.id)} class="doc-pager-card prev">
          <span class="doc-pager-subtitle">
            <ArrowLeft size={14} />
            <span>上一篇</span>
          </span>
          <span class="doc-pager-title">{prev.label}</span>
        </a>
      ) : (
        <div class="pager-placeholder" />
      )}
      {next && (
        <a href={href(next.id)} class="doc-pager-card next">
          <span class="doc-pager-subtitle">
            <span>下一篇</span>
            <ArrowRight size={14} />
          </span>
          <span class="doc-pager-title">{next.label}</span>
        </a>
      )}
    </nav>
  )
}

<style>
  .pager-placeholder {
    display: none;
  }
  @media (min-width: 641px) {
    .pager-placeholder {
      display: block;
    }
  }
</style>
