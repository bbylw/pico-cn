---
import type { CollectionEntry } from "astro:content";
import Base from "./Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
import Sidebar from "../components/Sidebar.astro";
import DocPager from "../components/DocPager.astro";
import { DOCS_NAV } from "../data/docs-nav";

interface Props {
  entry: CollectionEntry<"docs">;
}
const { entry } = Astro.props;
const { title, chapter, lead, toc = [], badge } = entry.data;
const desc = lead ? `${lead}｜Pico CSS 文档` : "Pico CSS 中文文档";
---

<Base title={`${title} | Pico CSS`} desc={desc}>
  <SiteHeader />
  <main class="docs-layout">
    <Sidebar current={entry.id} />
    <div class="content">
      <hgroup>
        <p class="chapter">{chapter}</p>
        <h1>{title}{badge === "new" && <span class="new-badge">新</span>}</h1>
        {lead && <p class="doc-lead" set:html={lead}></p>}
      </hgroup>
      <div id="doc-body">
        <slot />
      </div>
      <DocPager id={entry.id} />
    </div>
    {
      toc.length > 0 && (
        <aside class="toc" aria-label="本页目录">
          <nav>
            <strong>本页目录</strong>
            <ul>
              {toc.map((t) => (
                <li class={`depth-${t.depth}`}>
                  <a class="secondary" href={`#${t.id}`} data-toc-link={t.id}>
                    {t.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </aside>
      )
    }
  </main>
  <footer class="site-footer">
    <nav>
      <ul>
        <li><a class="secondary" href="/">首页</a></li>
        <li><a class="secondary" href="/docs/">文档</a></li>
        <li><a class="secondary" href="https://github.com/picocss/pico" rel="noopener external" target="_blank">GitHub</a></li>
      </ul>
      <ul>
        <li>
          <small>
            中文翻译自 <a href="https://picocss.com/docs" rel="noopener external">picocss.com/docs</a>，
            遵循 <a href="https://github.com/picocss/pico/blob/master/LICENSE.md" rel="noopener external">MIT 许可证</a>。
          </small>
        </li>
      </ul>
    </nav>
  </footer>
</Base>

<script>
  // TOC scroll-spy
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]"));
  if (links.length) {
    const map = new Map<string, HTMLAnchorElement>();
    links.forEach((l) => map.set(l.dataset.tocLink!, l));
    const headings = Array.from(map.keys())
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => !!el);
    const setActive = (id: string) => {
      links.forEach((l) => l.classList.remove("is-active"));
      map.get(id)?.classList.add("is-active");
    };
    const obs = new IntersectionObserver(
      (entries) => {
        const visible = entries.filter((e) => e.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible[0]) {
          setActive(visible[0].target.id);
        }
      },
      { rootMargin: "-88px 0px -66% 0px", threshold: 0 }
    );
    headings.forEach((h) => obs.observe(h));
  }
</script>
