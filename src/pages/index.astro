---
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SearchModal from "../components/SearchModal.astro";
import {
  Rocket,
  Palette,
  LayoutGrid,
  CheckCircle2,
  Sparkles,
  Zap,
  ShieldCheck,
  Package,
  Copy,
  Check,
  ArrowRight,
  ExternalLink,
  Code2,
  Terminal,
  Sliders,
  FileCode,
  Layers,
  Type
} from "lucide-astro";

const base = import.meta.env.BASE_URL;
const cdn = "https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css";
const npmCmd = "npm install @picocss/pico";
const sassCode = '@use "@picocss/pico";';
---

<Base
  title="Pico CSS · 面向原生语义化 HTML 的极简 CSS 框架"
  desc="极简、轻量的纯 CSS 框架，仅 15KB。以语义化语法为先，让原生 HTML 标签默认具备出众的排版、现代响应式布局与明暗主题。"
>
  <SiteHeader />
  <SearchModal />

  <main class="home-main" id="top">
    <!-- 1 · 旗舰 Hero 区域 -->
    <section class="hero-section" aria-label="介绍">
      <div class="hero-glow-ambient" aria-hidden="true"></div>
      <div class="hero-grid-pattern" aria-hidden="true"></div>

      <div class="home-container hero-inner">
        <!-- 左侧文案与行动号召 -->
        <div class="hero-copy">
          <div class="hero-badge">
            <span class="badge-pulsing-dot" aria-hidden="true"></span>
            <span>PICO CSS V2.1.1 · 官方中文文档</span>
          </div>

          <h1 class="hero-title">
            写原生 <code>HTML</code>，<br />
            <span class="hero-title-accent">就足够了。</span>
          </h1>

          <p class="hero-description">
            仅 <strong>15KB</strong> 轻量无依赖。抛弃数以千计的复杂类名记忆，让纯净的 HTML 标签在任何设备上开箱自带优雅排版、现代化响应式栅格与自适应明暗模式。
          </p>

          <div class="hero-cta-group">
            <a href={`${base}docs/`} class="btn-primary-glow">
              <span>开始探索文档</span>
              <ArrowRight size={17} />
            </a>
            <a
              href="https://github.com/picocss/pico"
              class="btn-secondary-glass"
              rel="noopener external"
              target="_blank"
            >
              <span>GitHub 仓库</span>
              <ExternalLink size={15} />
            </a>
          </div>

          <!-- 核心指标网格 -->
          <div class="hero-metrics">
            <div class="metric-card">
              <div class="metric-icon-wrap">
                <Package size={17} />
              </div>
              <div class="metric-text">
                <strong>约 15 KB</strong>
                <span>gzip 超轻量体积</span>
              </div>
            </div>

            <div class="metric-card">
              <div class="metric-icon-wrap">
                <Zap size={17} />
              </div>
              <div class="metric-text">
                <strong>0 JS 依赖</strong>
                <span>纯净原生无运行时</span>
              </div>
            </div>

            <div class="metric-card">
              <div class="metric-icon-wrap">
                <Palette size={17} />
              </div>
              <div class="metric-text">
                <strong>双主题自适应</strong>
                <span>原生浅色 / 深色模式</span>
              </div>
            </div>

            <div class="metric-card">
              <div class="metric-icon-wrap">
                <ShieldCheck size={17} />
              </div>
              <div class="metric-text">
                <strong>MIT 许可</strong>
                <span>自由开源免费商用</span>
              </div>
            </div>
          </div>
        </div>

        <!-- 右侧真实可交互组件视窗 (Live Showcase) -->
        <div class="hero-showcase">
          <div class="showcase-window" id="demo-window">
            <div class="showcase-window-bar">
              <div class="window-controls" aria-hidden="true">
                <span class="control-dot close"></span>
                <span class="control-dot min"></span>
                <span class="control-dot max"></span>
              </div>

              <div class="window-url-pill">
                <span class="url-lock">🔒</span>
                <span>picocss.ndjp.net/demo/</span>
              </div>

              <div class="window-live-tag">
                <span class="live-dot" aria-hidden="true"></span>
                <span>可交互预览</span>
              </div>
            </div>

            <div class="showcase-body">
              <div class="demo-header-group">
                <h3 class="demo-heading">Hello Pico!</h3>
                <p class="demo-sub">语义即样式：原生标签默认具备精致观感</p>
              </div>

              <!-- 搜索与提交 -->
              <div class="demo-search-row">
                <input
                  type="search"
                  id="showcase-search"
                  placeholder="搜索文档组件..."
                  aria-label="交互式输入框示例"
                />
                <button type="button" class="demo-search-btn">搜索</button>
              </div>

              <!-- 按钮变体 -->
              <div class="demo-button-row">
                <button type="button" class="demo-btn-main">主要按钮</button>
                <button type="button" class="demo-btn-sec secondary">次要按钮</button>
                <button type="button" class="demo-btn-out outline">轮廓样式</button>
              </div>

              <!-- 表单交互控件 -->
              <div class="demo-controls-grid">
                <label class="demo-switch-label">
                  <input type="checkbox" role="switch" checked id="showcase-theme-switch" />
                  <span>实时深色模式</span>
                </label>
                <label class="demo-checkbox-label">
                  <input type="checkbox" checked />
                  <span>自动记住配置</span>
                </label>
              </div>

              <!-- 滑块控件 -->
              <div class="demo-range-wrap">
                <div class="range-header">
                  <small>原生滑块组件 range</small>
                  <span id="range-val" class="range-val-badge">75%</span>
                </div>
                <input
                  type="range"
                  min="0"
                  max="100"
                  value="75"
                  id="showcase-range"
                  aria-label="滑块组件演示"
                />
              </div>

              <!-- 原生手风琴 -->
              <details class="demo-accordion" open>
                <summary>原生 details 手风琴（零 JS）</summary>
                <p>卡片、提示、下拉与弹窗同理，纯粹靠 HTML 语义标签即可工作。</p>
              </details>

              <!-- 颜色主题快速切换 -->
              <div class="demo-palette-bar">
                <span class="palette-label">点击试换主题色：</span>
                <div class="palette-dots">
                  <button type="button" class="dot-btn active" data-accent="#0172ad" title="Indigo (默认)" style="background: #0172ad;"></button>
                  <button type="button" class="dot-btn" data-accent="#0284c7" title="Azure" style="background: #0284c7;"></button>
                  <button type="button" class="dot-btn" data-accent="#059669" title="Jade" style="background: #059669;"></button>
                  <button type="button" class="dot-btn" data-accent="#ea580c" title="Pumpkin" style="background: #ea580c;"></button>
                  <button type="button" class="dot-btn" data-accent="#7c3aed" title="Violet" style="background: #7c3aed;"></button>
                </div>
              </div>
            </div>

            <div class="showcase-footer">
              <span>以上组件全部由浏览器原生渲染 · 支持直接点按体验</span>
            </div>
          </div>

          <!-- 悬浮特性徽章 -->
          <div class="floating-badge badge-top-right">
            <Sparkles size={14} class="badge-sparkle" />
            <span>Classless 无类名模式可用</span>
          </div>
          <div class="floating-badge badge-bottom-left">
            <Palette size={14} class="badge-sparkle" />
            <span>内置 20 款精选调色板</span>
          </div>
        </div>
      </div>
    </section>

    <!-- 2 · 一键安装选项卡 (Interactive Install Window) -->
    <section class="section-install" aria-label="安装方式">
      <div class="home-container">
        <div class="section-header text-center">
          <h2 class="section-title">一行代码，即刻起步</h2>
          <p class="section-subtitle">选择你喜欢的方式引入 Pico，开始极速构建纯净 Web 页面。</p>
        </div>

        <div class="install-terminal-box" data-tabs>
          <div class="terminal-topbar">
            <div class="terminal-dots" aria-hidden="true">
              <i></i><i></i><i></i>
            </div>

            <div class="install-tabs" role="tablist" aria-label="安装渠道">
              <button
                type="button"
                role="tab"
                id="tab-cdn"
                aria-controls="panel-cdn"
                aria-selected="true"
                class="tab-btn is-active"
              >
                CDN 引入
              </button>
              <button
                type="button"
                role="tab"
                id="tab-npm"
                aria-controls="panel-npm"
                aria-selected="false"
                tabindex="-1"
                class="tab-btn"
              >
                NPM 包
              </button>
              <button
                type="button"
                role="tab"
                id="tab-sass"
                aria-controls="panel-sass"
                aria-selected="false"
                tabindex="-1"
                class="tab-btn"
              >
                Sass 定制
              </button>
            </div>

            <button
              type="button"
              class="terminal-copy-btn"
              id="terminal-copy-action"
              data-copy-target={cdn}
              aria-label="复制代码"
            >
              <Copy size={13} class="copy-icon" />
              <Check size={13} class="check-icon" style="display:none;" />
              <span class="copy-label">复制代码</span>
            </button>
          </div>

          <div class="terminal-panels">
            <div role="tabpanel" id="panel-cdn" aria-labelledby="tab-cdn" data-content={cdn} class="tab-content">
              <pre class="terminal-pre"><code><span class="tk-tag">&lt;link</span> <span class="tk-attr">rel</span>=<span class="tk-val">"stylesheet"</span> <span class="tk-attr">href</span>=<span class="tk-val">"{cdn}"</span><span class="tk-tag">&gt;</span></code></pre>
            </div>

            <div role="tabpanel" id="panel-npm" aria-labelledby="tab-npm" data-content={npmCmd} class="tab-content" hidden>
              <pre class="terminal-pre"><code><span class="tk-cmd">$</span> {npmCmd}</code></pre>
            </div>

            <div role="tabpanel" id="panel-sass" aria-labelledby="tab-sass" data-content={sassCode} class="tab-content" hidden>
              <pre class="terminal-pre"><code><span class="tk-keyword">@use</span> <span class="tk-val">"@picocss/pico"</span>;  <span class="tk-comment">// 可自由按需覆盖 SCSS 变量</span></code></pre>
            </div>
          </div>

          <div class="terminal-footer">
            <small class="text-muted">当前版本 v2.1.1 · 支持所有现代现代主流浏览器</small>
            <div class="terminal-sublinks">
              <a href={`${base}docs/#install-manually`}>手动下载安装</a> ·
              <a href={`${base}docs/sass/`}>Sass 变量定制</a> ·
              <a href={`${base}docs/version-picker/`}>版本与颜色定制器</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 3 · 核心优势 Bento 网格 (Feature Bento) -->
    <section class="section-bento" aria-label="核心特性">
      <div class="home-container">
        <div class="section-header">
          <div class="section-pill">Why Pico CSS</div>
          <h2 class="section-title">恰到好处的设计平衡</h2>
          <p class="section-subtitle">
            Pico 是加强版的 HTML 重置套件，也是现代极简设计系统的优雅原点：先打理好所有默认标签，再留足扩展定制空间。
          </p>
        </div>

        <div class="bento-grid">
          <!-- Bento 1: 20 套精选配色 -->
          <article class="bento-card bento-span-2">
            <div class="bento-card-header">
              <div class="bento-icon-pill">
                <Palette size={18} />
              </div>
              <h3 class="bento-title">20 款主题调色板，自由随心</h3>
            </div>
            <p class="bento-desc">
              无需重写样式，引入预编译颜色版本即刻变身。官方以 Indigo 为默认，提供从暖红到青蓝完整的色彩家族。
            </p>

            <div class="bento-swatches-interactive">
              <span class="pico-background-indigo-500" title="Indigo"></span>
              <span class="pico-background-blue-500" title="Blue"></span>
              <span class="pico-background-azure-500" title="Azure"></span>
              <span class="pico-background-cyan-500" title="Cyan"></span>
              <span class="pico-background-jade-500" title="Jade"></span>
              <span class="pico-background-green-500" title="Green"></span>
              <span class="pico-background-lime-500" title="Lime"></span>
              <span class="pico-background-yellow-500" title="Yellow"></span>
              <span class="pico-background-amber-500" title="Amber"></span>
              <span class="pico-background-pumpkin-500" title="Pumpkin"></span>
              <span class="pico-background-orange-500" title="Orange"></span>
              <span class="pico-background-red-500" title="Red"></span>
              <span class="pico-background-pink-500" title="Pink"></span>
              <span class="pico-background-fuchsia-500" title="Fuchsia"></span>
              <span class="pico-background-purple-500" title="Purple"></span>
              <span class="pico-background-violet-500" title="Violet"></span>
            </div>

            <div class="bento-spectrum-bar" title="50 到 950 级色阶渐变">
              <span class="pico-background-indigo-100"></span>
              <span class="pico-background-indigo-200"></span>
              <span class="pico-background-indigo-300"></span>
              <span class="pico-background-indigo-400"></span>
              <span class="pico-background-indigo-500"></span>
              <span class="pico-background-indigo-600"></span>
              <span class="pico-background-indigo-700"></span>
              <span class="pico-background-indigo-800"></span>
              <span class="pico-background-indigo-900"></span>
            </div>

            <a href={`${base}docs/colors/`} class="bento-explore-link">
              <span>探索色彩系统文档</span>
              <ArrowRight size={14} />
            </a>
          </article>

          <!-- Bento 2: 明暗模式 -->
          <article class="bento-card">
            <div class="bento-card-header">
              <div class="bento-icon-pill">
                <Sparkles size={18} />
              </div>
              <h3 class="bento-title">零闪烁明暗模式</h3>
            </div>
            <p class="bento-desc">
              自动监听系统偏好；支持 <code>data-theme</code> 属性钉住浅色或深色，首帧渲染平滑无白闪。
            </p>

            <div class="bento-theme-preview">
              <div class="theme-half light-half">
                <span>浅色 Light</span>
              </div>
              <div class="theme-half dark-half">
                <span>深色 Dark</span>
              </div>
            </div>

            <a href={`${base}docs/color-schemes/`} class="bento-explore-link">
              <span>了解配色方案</span>
              <ArrowRight size={14} />
            </a>
          </article>

          <!-- Bento 3: 容器与栅格 -->
          <article class="bento-card">
            <div class="bento-card-header">
              <div class="bento-icon-pill">
                <LayoutGrid size={18} />
              </div>
              <h3 class="bento-title">自适应容器与栅格</h3>
            </div>
            <p class="bento-desc">
              语义化 <code>.container</code> 与 <code>.grid</code>，在手机、平板与超宽屏之间流式响应，无需断点补丁。
            </p>

            <div class="bento-grid-demo">
              <div class="grid-sample-cols">
                <span class="col-highlight"></span>
                <span class="col-highlight"></span>
                <span class="col-highlight"></span>
                <span class="col-box"></span>
                <span class="col-box"></span>
                <span class="col-box"></span>
              </div>
            </div>

            <a href={`${base}docs/grid/`} class="bento-explore-link">
              <span>查看栅格排版</span>
              <ArrowRight size={14} />
            </a>
          </article>

          <!-- Bento 4: 语义排版 -->
          <article class="bento-card bento-span-2">
            <div class="bento-card-header">
              <div class="bento-icon-pill">
                <Code2 size={18} />
              </div>
              <h3 class="bento-title">优雅的排版层级与中文支持</h3>
            </div>
            <p class="bento-desc">
              标题、引用、正文、标记与表格自带舒适的黄金行高。经过精细的中文 Web 字体回退调校，清晰易读。
            </p>

            <div class="bento-typography-preview">
              <div class="type-badge">Aa</div>
              <div class="type-show">
                <span class="type-h">大标题 Heading</span>
                <span class="type-p">正文段落细腻柔和</span>
                <span class="type-tags">
                  <code>&lt;code&gt;</code>
                  <kbd>⌘ K</kbd>
                  <mark>高亮文本</mark>
                </span>
              </div>
            </div>

            <a href={`${base}docs/typography/`} class="bento-explore-link">
              <span>排版与文本规范</span>
              <ArrowRight size={14} />
            </a>
          </article>
        </div>
      </div>
    </section>

    <!-- 4 · 12 行起步示例 (Starter Workbench) -->
    <section class="section-starter" aria-label="起步模板">
      <div class="home-container">
        <div class="section-header">
          <div class="section-pill">Quickstart Template</div>
          <h2 class="section-title">12 行 HTML，见证开箱即美</h2>
          <p class="section-subtitle">
            无需复杂的构建链或打包配置。建立一个纯 HTML 文件，粘贴模板，在浏览器里双击打开就是现代化界面。
          </p>
        </div>

        <div class="starter-workbench">
          <!-- 左侧代码视图 -->
          <div class="workbench-code">
            <div class="workbench-topbar">
              <div class="terminal-dots" aria-hidden="true">
                <i></i><i></i><i></i>
              </div>
              <span class="file-name">index.html</span>
              <button
                type="button"
                class="terminal-copy-btn"
                id="copy-template-btn"
                data-copy={`<!doctype html>\n<html lang="zh-CN">\n  <head>\n    <meta charset="utf-8">\n    <meta name="viewport" content="width=device-width, initial-scale=1">\n    <meta name="color-scheme" content="light dark">\n    <link rel="stylesheet" href="${cdn}">\n    <title>Hello world!</title>\n  </head>\n  <body>\n    <main class="container">\n      <h1>Hello world!</h1>\n      <p>写原生 HTML 就够了。</p>\n    </main>\n  </body>\n</html>`}
              >
                <Copy size={13} class="copy-icon" />
                <Check size={13} class="check-icon" style="display:none;" />
                <span class="copy-label">复制模板</span>
              </button>
            </div>

            <pre class="workbench-pre"><code><span class="cl"><span class="tk-tag">&lt;!doctype html&gt;</span></span>
<span class="cl"><span class="tk-tag">&lt;html</span> <span class="tk-attr">lang</span>=<span class="tk-val">"zh-CN"</span><span class="tk-tag">&gt;</span></span>
<span class="cl">  <span class="tk-tag">&lt;head&gt;</span></span>
<span class="cl">    <span class="tk-tag">&lt;meta</span> <span class="tk-attr">charset</span>=<span class="tk-val">"utf-8"</span><span class="tk-tag">&gt;</span></span>
<span class="cl">    <span class="tk-tag">&lt;meta</span> <span class="tk-attr">name</span>=<span class="tk-val">"viewport"</span> <span class="tk-attr">content</span>=<span class="tk-val">"width=device-width, initial-scale=1"</span><span class="tk-tag">&gt;</span></span>
<span class="cl">    <span class="tk-tag">&lt;meta</span> <span class="tk-attr">name</span>=<span class="tk-val">"color-scheme"</span> <span class="tk-attr">content</span>=<span class="tk-val">"light dark"</span><span class="tk-tag">&gt;</span></span>
<span class="cl">    <span class="tk-tag">&lt;link</span> <span class="tk-attr">rel</span>=<span class="tk-val">"stylesheet"</span> <span class="tk-attr">href</span>=<span class="tk-val">"…/pico.min.css"</span><span class="tk-tag">&gt;</span></span>
<span class="cl">    <span class="tk-tag">&lt;title&gt;</span>Hello world!<span class="tk-tag">&lt;/title&gt;</span></span>
<span class="cl">  <span class="tk-tag">&lt;/head&gt;</span></span>
<span class="cl">  <span class="tk-tag">&lt;body&gt;</span></span>
<span class="cl">    <span class="tk-tag">&lt;main</span> <span class="tk-attr">class</span>=<span class="tk-val">"container"</span><span class="tk-tag">&gt;</span></span>
<span class="cl">      <span class="tk-tag">&lt;h1&gt;</span>Hello world!<span class="tk-tag">&lt;/h1&gt;</span></span>
<span class="cl">      <span class="tk-tag">&lt;p&gt;</span>写原生 HTML 就够了。<span class="tk-tag">&lt;/p&gt;</span></span>
<span class="cl">    <span class="tk-tag">&lt;/main&gt;</span></span>
<span class="cl">  <span class="tk-tag">&lt;/body&gt;</span></span>
<span class="cl"><span class="tk-tag">&lt;/html&gt;</span></span></code></pre>
          </div>

          <!-- 右侧效果呈现 -->
          <div class="workbench-demo">
            <div class="workbench-demo-header">
              <span class="live-status-dot"></span>
              <span>浏览器渲染效果</span>
            </div>

            <div class="workbench-demo-canvas">
              <h3>Hello world!</h3>
              <p>原生标题与正文段落，已具备现代响应式留白与优美字距。</p>
              <div class="demo-card-box">
                <strong>语义化卡片与表单示例</strong>
                <p>无需记忆复杂 class，Pico 根据 HTML 标签关系智能渲染。</p>
                <div class="demo-card-actions">
                  <a href={`${base}docs/`} role="button" class="small">立即阅读教程</a>
                  <a href={`${base}docs/forms/`} role="button" class="small secondary">查看表单</a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 5 · 文档导航矩阵 (Documentation Matrix) -->
    <section class="section-matrix" aria-label="文档导航">
