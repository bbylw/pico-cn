<script>
  // 1. 通用复制按钮逻辑
  function setupCopyButton(btn: HTMLElement, textToCopy: string) {
    btn.addEventListener("click", async () => {
      const copyIcon = btn.querySelector(".copy-icon") as HTMLElement | null;
      const checkIcon = btn.querySelector(".check-icon") as HTMLElement | null;
      const copyLabel = btn.querySelector(".copy-label") as HTMLElement | null;

      try {
        await navigator.clipboard.writeText(textToCopy);
      } catch {
        const ta = document.createElement("textarea");
        ta.value = textToCopy;
        document.body.appendChild(ta);
        ta.select();
        document.execCommand("copy");
        ta.remove();
      }

      if (copyIcon && checkIcon && copyLabel) {
        copyIcon.style.display = "none";
        checkIcon.style.display = "inline-block";
        copyLabel.textContent = "已复制 ✓";
        btn.style.borderColor = "#10b981";
        btn.style.color = "#10b981";

        setTimeout(() => {
          copyIcon.style.display = "inline-block";
          checkIcon.style.display = "none";
          copyLabel.textContent = "复制代码";
          btn.style.borderColor = "";
          btn.style.color = "";
        }, 1600);
      }
    });
  }

  // 终端选项卡与复制逻辑
  const terminalBox = document.querySelector("[data-tabs]");
  if (terminalBox) {
    const tabs = Array.from(terminalBox.querySelectorAll<HTMLElement>('[role="tab"]'));
    const panels = Array.from(terminalBox.querySelectorAll<HTMLElement>('[role="tabpanel"]'));
    const copyBtn = document.getElementById("terminal-copy-action");

    let currentContent = panels[0]?.getAttribute("data-content") || "";

    if (copyBtn) {
      copyBtn.addEventListener("click", async () => {
        const copyIcon = copyBtn.querySelector(".copy-icon") as HTMLElement | null;
        const checkIcon = copyBtn.querySelector(".check-icon") as HTMLElement | null;
        const copyLabel = copyBtn.querySelector(".copy-label") as HTMLElement | null;

        try {
          await navigator.clipboard.writeText(currentContent);
        } catch {
          const ta = document.createElement("textarea");
          ta.value = currentContent;
          document.body.appendChild(ta);
          ta.select();
          document.execCommand("copy");
          ta.remove();
        }

        if (copyIcon && checkIcon && copyLabel) {
          copyIcon.style.display = "none";
          checkIcon.style.display = "inline-block";
          copyLabel.textContent = "已复制 ✓";
          copyBtn.style.borderColor = "#10b981";
          copyBtn.style.color = "#10b981";

          setTimeout(() => {
            copyIcon.style.display = "inline-block";
            checkIcon.style.display = "none";
            copyLabel.textContent = "复制代码";
            copyBtn.style.borderColor = "";
            copyBtn.style.color = "";
          }, 1600);
        }
      });
    }

    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => {
        tabs.forEach((t) => {
          t.classList.remove("is-active");
          t.setAttribute("aria-selected", "false");
          t.tabIndex = -1;
        });
        tab.classList.add("is-active");
        tab.setAttribute("aria-selected", "true");
        tab.tabIndex = 0;

        panels.forEach((p) => {
          if (p.id === tab.getAttribute("aria-controls")) {
            p.removeAttribute("hidden");
            currentContent = p.getAttribute("data-content") || "";
          } else {
            p.setAttribute("hidden", "");
          }
        });
      });
    });
  }

  // 起步模板复制代码
  const copyTemplateBtn = document.getElementById("copy-template-btn");
  if (copyTemplateBtn) {
    const text = copyTemplateBtn.getAttribute("data-copy") || "";
    setupCopyButton(copyTemplateBtn, text);
  }

  // 2. Showcase 交互：滑块百分比联动
  const rangeInput = document.getElementById("showcase-range") as HTMLInputElement | null;
  const rangeBadge = document.getElementById("range-val");
  if (rangeInput && rangeBadge) {
    rangeInput.addEventListener("input", () => {
      rangeBadge.textContent = `${rangeInput.value}%`;
    });
  }

  // 3. Showcase 交互：主题明暗开关联动 demo-window
  const themeSwitch = document.getElementById("showcase-theme-switch") as HTMLInputElement | null;
  const demoWindow = document.getElementById("demo-window");
  if (themeSwitch && demoWindow) {
    themeSwitch.addEventListener("change", () => {
      if (themeSwitch.checked) {
        demoWindow.setAttribute("data-theme-override", "dark");
      } else {
        demoWindow.setAttribute("data-theme-override", "light");
      }
    });
  }

  // 4. Showcase 交互：主题颜色小点即时变色
  const dots = document.querySelectorAll<HTMLButtonElement>(".palette-dots .dot-btn");
  dots.forEach((dot) => {
    dot.addEventListener("click", () => {
      dots.forEach((d) => d.classList.remove("active"));
      dot.classList.add("active");
      const color = dot.getAttribute("data-accent");
      if (color && demoWindow) {
        demoWindow.style.setProperty("--pico-primary", color);
      }
    });
  });
</script>

