    gap: 1.15rem;
  }

  .demo-heading {
    font-size: 1.25rem;
    font-weight: 750;
    margin: 0 0 0.2rem;
    color: var(--pico-color);
  }

  .demo-sub {
    font-size: 0.86rem;
    color: var(--pico-muted-color);
    margin: 0;
  }

  .demo-search-row {
    display: flex;
    gap: 0.5rem;
  }

  .demo-search-row input[type="search"] {
    flex: 1;
    margin: 0;
    font-size: 0.88rem;
    padding: 0.5rem 0.85rem;
  }

  .demo-search-btn {
    margin: 0;
    padding: 0.5rem 1.25rem;
    font-size: 0.88rem;
    white-space: nowrap;
    border-radius: 8px;
  }

  .demo-button-row {
    display: flex;
    gap: 0.55rem;
    flex-wrap: wrap;
  }

  .demo-button-row button {
    margin: 0;
    padding: 0.45rem 0.95rem;
    font-size: 0.82rem;
    border-radius: 6px;
  }

  .demo-controls-grid {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .demo-controls-grid label {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.84rem;
    margin: 0;
    cursor: pointer;
    color: var(--pico-color);
  }

  .demo-range-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .range-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .range-header small {
    color: var(--pico-muted-color);
    font-size: 0.78rem;
  }

  .range-val-badge {
    font-size: 0.74rem;
    font-weight: 700;
    color: var(--pico-primary);
  }

  .demo-range-wrap input[type="range"] {
    margin: 0;
  }

  .demo-accordion {
    margin: 0;
    padding: 0.65rem 1rem;
    border: 1px solid var(--site-border);
    border-radius: 8px;
    background: var(--pico-background-color);
    font-size: 0.86rem;
  }

  .demo-accordion summary {
    font-weight: 600;
    font-size: 0.86rem;
    margin: 0;
  }

  .demo-accordion p {
    margin: 0.5rem 0 0;
    font-size: 0.82rem;
    color: var(--pico-muted-color);
  }

  .demo-palette-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.55rem 0.85rem;
    border-radius: 8px;
    background: color-mix(in srgb, var(--pico-primary) 6%, transparent);
    border: 1px solid color-mix(in srgb, var(--pico-primary) 18%, transparent);
  }

  .palette-label {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--pico-color);
  }

  .palette-dots {
    display: flex;
    gap: 0.35rem;
  }

  .dot-btn {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 2px solid transparent;
    padding: 0;
    margin: 0;
    cursor: pointer;
    transition: transform 0.15s ease, border-color 0.15s ease;
  }

  .dot-btn:hover {
    transform: scale(1.15);
  }

  .dot-btn.active {
    border-color: #ffffff;
    box-shadow: 0 0 0 1px var(--pico-primary);
  }

  .showcase-footer {
    padding: 0.65rem 1.25rem;
    border-top: 1px solid var(--site-border);
    font-size: 0.76rem;
    color: var(--pico-muted-color);
    text-align: center;
    background: color-mix(in srgb, var(--pico-card-background-color) 92%, black);
  }

  /* 悬浮特性徽章 */
  .floating-badge {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    font-size: 0.76rem;
    font-weight: 600;
    background: var(--pico-card-background-color);
    border: 1px solid var(--site-border);
    box-shadow: var(--site-shadow-md);
    color: var(--pico-color);
    backdrop-filter: blur(8px);
    pointer-events: none;
  }

  .badge-top-right {
    top: -6px;
    right: 20px;
  }

  .badge-bottom-left {
    bottom: -6px;
    left: 20px;
  }

  .badge-sparkle {
    color: var(--pico-primary);
  }

  @media (max-width: 640px) {
    .floating-badge {
      display: none;
    }
  }

  /* --------------------------------------------------------------------------
     2 · 一键安装终端栏
     -------------------------------------------------------------------------- */
  .section-install {
    padding-block: 5rem;
    border-bottom: 1px solid var(--site-border);
  }

  .section-header {
    margin-bottom: 2.8rem;
  }

  .section-header.text-center {
    text-align: center;
  }

  .section-pill {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    font-family: var(--pico-font-family-monospace);
    color: var(--pico-primary);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.4rem;
  }

  .section-title {
    font-size: clamp(1.85rem, 3.5vw, 2.4rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    margin: 0 0 0.6rem;
    color: var(--pico-color);
  }

  .section-subtitle {
    font-size: 1.05rem;
    color: var(--pico-muted-color);
    max-width: 58ch;
    margin: 0 auto;
    text-wrap: pretty;
  }

  .install-terminal-box {
    max-width: 820px;
    margin-inline: auto;
    border: 1px solid var(--site-border);
    border-radius: 12px;
    background: var(--pico-card-background-color);
    box-shadow: var(--site-shadow-md);
    overflow: hidden;
  }

  .terminal-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.65rem 1.15rem;
    border-bottom: 1px solid var(--site-border);
    background: color-mix(in srgb, var(--pico-card-background-color) 85%, transparent);
    gap: 1rem;
    flex-wrap: wrap;
  }

  .terminal-dots {
    display: flex;
    gap: 0.35rem;
  }

  .terminal-dots i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    display: block;
    background: rgba(125, 125, 125, 0.28);
  }

  .install-tabs {
    display: inline-flex;
    gap: 0.25rem;
    background: var(--pico-background-color);
    border: 1px solid var(--site-border);
    border-radius: 999px;
    padding: 0.2rem;
  }

  .tab-btn {
    border: none;
    background: transparent;
    font-size: 0.78rem;
    font-weight: 600;
    padding: 0.25rem 0.85rem;
    border-radius: 999px;
    color: var(--pico-muted-color);
    cursor: pointer;
    margin: 0;
    transition: all 0.15s ease;
  }

  .tab-btn.is-active {
    background: var(--pico-primary);
    color: #ffffff;
  }

  .terminal-copy-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border: 1px solid var(--site-border);
    background: transparent;
    padding: 0.25rem 0.75rem;
    border-radius: 6px;
    font-size: 0.76rem;
    font-weight: 600;
    color: var(--pico-color);
    cursor: pointer;
    margin: 0;
    transition: all 0.15s ease;
  }

  .terminal-copy-btn:hover {
    border-color: var(--pico-primary);
    color: var(--pico-primary);
  }

  .terminal-panels {
    background: var(--code-bg);
  }

  .terminal-pre {
    margin: 0;
    padding: 1.25rem 1.4rem;
    font-family: var(--pico-font-family-monospace);
    font-size: 0.92rem;
    overflow-x: auto;
    border: none;
    background: transparent !important;
  }

  .tk-tag { color: #f43f5e; }
  .tk-attr { color: #8b5cf6; }
  .tk-val { color: #10b981; }
  .tk-cmd { color: var(--pico-primary); font-weight: 700; }
  .tk-keyword { color: #ec4899; }
  .tk-comment { color: var(--pico-muted-color); font-style: italic; }

  .terminal-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1.25rem;
    border-top: 1px solid var(--site-border);
    font-size: 0.8rem;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .terminal-sublinks a {
    color: var(--pico-muted-color);
    text-decoration: none;
  }
  .terminal-sublinks a:hover {
    color: var(--pico-primary);
  }

  /* --------------------------------------------------------------------------
     3 · Bento 核心优势网格
     -------------------------------------------------------------------------- */
  .section-bento {
    padding-block: 5.5rem;
    border-bottom: 1px solid var(--site-border);
  }

  .bento-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }

  @media (max-width: 959px) {
    .bento-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .bento-grid {
      grid-template-columns: 1fr;
    }
  }

  .bento-span-2 {
    grid-column: span 2;
  }

  @media (max-width: 640px) {
    .bento-span-2 {
      grid-column: span 1;
    }
  }

  .bento-card {
    border: 1px solid var(--site-border);
    border-radius: 12px;
    background: var(--pico-card-background-color);
    padding: 1.65rem;
    box-shadow: var(--site-shadow-sm);
    display: flex;
    flex-direction: column;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .bento-card:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--pico-primary) 38%, var(--site-border));
    box-shadow: var(--site-shadow-md);
  }

  .bento-card-header {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 0.5rem;
  }

  .bento-icon-pill {
    color: var(--pico-primary);
  }

  .bento-title {
    font-size: 1.12rem;
    font-weight: 750;
    margin: 0;
    color: var(--pico-color);
  }

  .bento-desc {
    font-size: 0.88rem;
    color: var(--pico-muted-color);
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  .bento-explore-link {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--pico-primary);
    text-decoration: none;
    transition: gap 0.15s ease;
  }

  .bento-explore-link:hover {
    gap: 0.55rem;
    text-decoration: none;
  }

  /* Bento 1: 颜色球与渐变 */
  .bento-swatches-interactive {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-bottom: 0.85rem;
  }

  .bento-swatches-interactive span {
    width: 1.8rem;
    height: 1.8rem;
    border-radius: 50%;
    border: 1px solid rgba(0, 0, 0, 0.1);
    transition: transform 0.15s ease;
    cursor: pointer;
  }

  .bento-swatches-interactive span:hover {
    transform: scale(1.22);
  }

  .bento-spectrum-bar {
    display: grid;
    grid-template-columns: repeat(9, minmax(0, 1fr));
    gap: 0.25rem;
    margin-bottom: 1.25rem;
  }

  .bento-spectrum-bar span {
    height: 1.2rem;
    border-radius: 4px;
  }

  /* Bento 2: 明暗对比卡 */
  .bento-theme-preview {
    display: flex;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--site-border);
    margin-bottom: 1.25rem;
    height: 80px;
  }

  .theme-half {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.82rem;
    font-weight: 700;
  }

  .light-half {
    background: #ffffff;
    color: #1e293b;
    border-right: 1px solid rgba(0, 0, 0, 0.08);
  }

  .dark-half {
    background: #090d16;
    color: #f1f5f9;
  }

  /* Bento 3: 栅格演示 */
  .bento-grid-demo {
    margin-bottom: 1.25rem;
  }

  .grid-sample-cols {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 0.35rem;
  }

  .col-highlight {
    height: 2.5rem;
    border-radius: 6px;
    background: color-mix(in srgb, var(--pico-primary) 22%, transparent);
    border: 1px solid var(--pico-primary);
  }

  .col-box {
    height: 2.5rem;
    border-radius: 6px;
    border: 1px dashed var(--site-border);
  }

  /* Bento 4: 字体排版 */
  .bento-typography-preview {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 0.95rem 1.25rem;
    border-radius: 8px;
    background: color-mix(in srgb, var(--pico-primary) 5%, var(--site-card-bg));
    border: 1px solid var(--site-border);
    margin-bottom: 1.25rem;
  }

  .type-badge {
    font-size: 2.6rem;
    font-weight: 850;
    line-height: 1;
    color: var(--pico-color);
    letter-spacing: -0.04em;
  }

  .type-show {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .type-h {
    font-size: 1rem;
    font-weight: 700;
    color: var(--pico-color);
  }

  .type-p {
    font-size: 0.82rem;
    color: var(--pico-muted-color);
  }

  .type-tags {
    display: flex;
    gap: 0.4rem;
    margin-top: 0.2rem;
  }

  /* --------------------------------------------------------------------------
     4 · 12 行起步双栏工作台
     -------------------------------------------------------------------------- */
  .section-starter {
    padding-block: 5.5rem;
    border-bottom: 1px solid var(--site-border);
  }

  .starter-workbench {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    border: 1px solid var(--site-border);
    border-radius: 14px;
    background: var(--pico-card-background-color);
    box-shadow: var(--site-shadow-md);
    overflow: hidden;
  }

  @media (max-width: 959px) {
    .starter-workbench {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .workbench-code {
    border-right: 1px solid var(--site-border);
    background: var(--code-bg);
  }

  @media (max-width: 959px) {
    .workbench-code {
      border-right: none;
      border-bottom: 1px solid var(--site-border);
    }
  }

  .workbench-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.65rem 1.1rem;
    border-bottom: 1px solid var(--site-border);
    font-size: 0.78rem;
    color: var(--pico-muted-color);
  }

  .file-name {
    font-family: var(--pico-font-family-monospace);
    font-weight: 600;
  }

  .workbench-pre {
    margin: 0;
    padding: 1.25rem 1.4rem;
    font-family: var(--pico-font-family-monospace);
    font-size: 0.85rem;
    line-height: 1.75;
    overflow-x: auto;
    background: transparent !important;
    border: none;
    counter-reset: line;
  }

  .code-lines .cl,
  .workbench-pre .cl {
    display: block;
    position: relative;
    padding-left: 2.2rem;
  }

  .workbench-pre .cl::before {
    counter-increment: line;
    content: counter(line);
    position: absolute;
    left: 0;
    width: 1.5rem;
    text-align: right;
    color: var(--pico-muted-color);
    opacity: 0.45;
    user-select: none;
    font-size: 0.78rem;
  }

  .workbench-demo {
    display: flex;
    flex-direction: column;
    background: var(--pico-card-background-color);
  }

  .workbench-demo-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 1.1rem;
    border-bottom: 1px solid var(--site-border);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--pico-muted-color);
  }

  .live-status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #10b981;
  }

  .workbench-demo-canvas {
    padding: 1.85rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .workbench-demo-canvas h3 {
    margin: 0;
    font-size: 1.4rem;
    color: var(--pico-color);
  }

  .demo-card-box {
    padding: 1.15rem 1.25rem;
    border-radius: 8px;
    border: 1px solid var(--site-border);
    background: var(--pico-background-color);
  }

  .demo-card-box strong {
    display: block;
    font-size: 0.95rem;
    color: var(--pico-color);
    margin-bottom: 0.35rem;
  }

  .demo-card-box p {
    font-size: 0.84rem;
    color: var(--pico-muted-color);
    margin-bottom: 0.85rem;
  }

  .demo-card-actions {
    display: flex;
    gap: 0.5rem;
  }

  .demo-card-actions a[role="button"] {
    margin: 0;
    padding: 0.35rem 0.75rem;
    font-size: 0.8rem;
    border-radius: 6px;
  }

  /* --------------------------------------------------------------------------
     5 · 文档全景导航矩阵
     -------------------------------------------------------------------------- */
  .section-matrix {
    padding-block: 5.5rem;
    border-bottom: 1px solid var(--site-border);
  }

  .matrix-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }

  @media (max-width: 959px) {
    .matrix-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .matrix-grid {
      grid-template-columns: 1fr;
    }
  }

  .matrix-card {
    border: 1px solid var(--site-border);
    border-radius: 12px;
    background: var(--pico-card-background-color);
    padding: 1.4rem 1.5rem;
    box-shadow: var(--site-shadow-sm);
    transition: all 0.2s ease;
  }

  .matrix-card:hover {
    border-color: color-mix(in srgb, var(--pico-primary) 35%, var(--site-border));
    transform: translateY(-2px);
    box-shadow: var(--site-shadow-md);
  }

  .matrix-card-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding-bottom: 0.85rem;
    margin-bottom: 0.85rem;
    border-bottom: 1px solid var(--site-border-subtle);
  }

  .matrix-icon {
    color: var(--pico-primary);
  }

  .matrix-card-head h3 {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 750;
    flex: 1;
  }

  .matrix-card-head h3 a {
    color: var(--pico-color);
    text-decoration: none;
  }

  .matrix-card-head h3 a:hover {
    color: var(--pico-primary);
  }

  .matrix-count {
    font-size: 0.74rem;
    color: var(--pico-muted-color);
    background: rgba(125, 125, 125, 0.1);
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
  }

  .matrix-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .matrix-links a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.88rem;
    color: var(--pico-color);
    opacity: 0.85;
    text-decoration: none;
    transition: all 0.15s ease;
    padding: 0.15rem 0;
  }

  .matrix-links a:hover {
    opacity: 1;
    color: var(--pico-primary);
    transform: translateX(3px);
  }

  /* --------------------------------------------------------------------------
     6 · 尾声行动面板
     -------------------------------------------------------------------------- */
  .section-final-cta {
    padding-block: 5rem 6rem;
  }

  .final-cta-card {
    position: relative;
    border-radius: 18px;
    background: linear-gradient(135deg, #0172ad 0%, #4338ca 100%);
    color: #ffffff;
    padding: 4.5rem 2rem;
    text-align: center;
    overflow: hidden;
    box-shadow: 0 25px 60px -15px rgba(1, 114, 173, 0.35);
  }

  .final-cta-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 0%, rgba(255, 255, 255, 0.2) 0%, transparent 70%);
    pointer-events: none;
  }

  .final-cta-content {
    position: relative;
    z-index: 1;
    max-width: 620px;
    margin-inline: auto;
  }

  .final-cta-title {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 850;
    margin-bottom: 0.85rem;
    color: #ffffff;
    letter-spacing: -0.03em;
  }

  .final-cta-desc {
    font-size: 1.1rem;
    color: rgba(255, 255, 255, 0.88);
    line-height: 1.6;
    margin-bottom: 2.2rem;
  }

  .final-cta-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn-final-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.8rem 1.8rem;
    border-radius: 10px;
    font-size: 1rem;
    font-weight: 700;
    background: #ffffff;
    color: #0172ad !important;
    text-decoration: none;
    box-shadow: 0 10px 25px -6px rgba(0, 0, 0, 0.25);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .btn-final-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 15px 30px -6px rgba(0, 0, 0, 0.35);
    text-decoration: none;
  }

  .btn-final-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.8rem 1.6rem;
